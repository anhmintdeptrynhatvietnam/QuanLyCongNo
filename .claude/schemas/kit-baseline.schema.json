{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://fis-ai-kit.local/schemas/kit-baseline.schema.json",
  "title": "FIS AI Kit drift baselines",
  "description": "Schema for the three generated baselines DAI reads to detect drift. Each baseline validates against its own definition: kit-baseline.json against #/$defs/kitBaseline, native-hook-expectations.json against #/$defs/hookExpectations, native-skill-hashes.json against #/$defs/skillHashes. See docs/reference/dai-drift-contract.md.",
  "$ref": "#/$defs/kitBaseline",
  "$defs": {
    "schemaVersion": { "const": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$",
      "description": "Project-relative POSIX path. Leading slash, parent traversal, and backslashes are rejected so a baseline survives cloning."
    },
    "kitBaseline": {
      "type": "object",
      "required": ["kitBaselineSchema", "kitVersion", "generatedAt", "baselines", "checker"],
      "additionalProperties": false,
      "properties": {
        "kitBaselineSchema": { "$ref": "#/$defs/schemaVersion" },
        "kitVersion": { "type": "string", "minLength": 1 },
        "generatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date only. A per-second stamp would make every regeneration a diff and defeat the staleness check."
        },
        "baselines": {
          "type": "object",
          "required": ["hookExpectations", "skillHashes"],
          "additionalProperties": false,
          "properties": {
            "hookExpectations": { "$ref": "#/$defs/relativePath" },
            "skillHashes": { "$ref": "#/$defs/relativePath" }
          }
        },
        "checker": { "$ref": "#/$defs/relativePath" }
      }
    },
    "hookExpectations": {
      "type": "object",
      "required": ["kitBaselineSchema", "generatedFrom", "wiringSha256", "events", "hookFiles"],
      "additionalProperties": false,
      "properties": {
        "kitBaselineSchema": { "$ref": "#/$defs/schemaVersion" },
        "generatedFrom": { "$ref": "#/$defs/relativePath" },
        "wiringSha256": { "$ref": "#/$defs/sha256" },
        "events": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "description": "Blocks in execution order. Order is significant.",
            "items": {
              "type": "object",
              "required": ["matcher", "hooks"],
              "additionalProperties": false,
              "properties": {
                "matcher": { "type": "string", "minLength": 1 },
                "hooks": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "hookFiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "skillHashes": {
      "type": "object",
      "required": ["kitBaselineSchema", "algorithm", "files"],
      "additionalProperties": false,
      "properties": {
        "kitBaselineSchema": { "$ref": "#/$defs/schemaVersion" },
        "algorithm": { "const": "sha256" },
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/sha256" },
          "propertyNames": { "$ref": "#/$defs/relativePath" }
        }
      }
    }
  }
}
